{
    "name": "rodrigo/programming-with-gio",
    "description": "Projeto de estudo PHP desenvolvido durante o curso Programming with Gio.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "ramsey/uuid": "^4.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@validate-config",
            "@check-platform"
        ],
        "validate-config": [
            "@composer validate --strict"
        ],
        "check-platform": [
            "@composer check-platform-reqs"
        ],
        "refresh-autoload": [
            "@composer dump-autoload"
        ]
    }
}
