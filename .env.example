# ======================================================================
# Programming with Gio
# Exemplo de variáveis de ambiente da infraestrutura local
# ======================================================================
#
# Este arquivo documenta as variáveis necessárias para executar
# o ambiente de desenvolvimento.
#
# Não armazene senhas reais, tokens ou outras informações
# confidenciais neste arquivo.
#
# Para preparar o ambiente local, copie este arquivo:
#
# cp .env.example .env
#
# Depois, ajuste no arquivo .env os valores específicos do computador.
#
# O arquivo .env não deverá ser versionado pelo Git.
# ======================================================================


# ----------------------------------------------------------------------
# Nome do projeto no Docker Compose
# ----------------------------------------------------------------------
# Esse nome será usado como prefixo dos contêineres, redes,
# imagens e volumes criados pelo Docker Compose.
#
# Use apenas letras minúsculas, números, hífens e sublinhados.
COMPOSE_PROJECT_NAME=programming-with-gio


# ----------------------------------------------------------------------
# Porta HTTP local
# ----------------------------------------------------------------------
# Porta utilizada para acessar o Nginx pelo computador.
#
# Com o valor 8081, a aplicação ficará disponível em:
#
# http://localhost:8081
#
# Altere o valor caso a porta já esteja sendo utilizada.
APP_PORT=8081


# ----------------------------------------------------------------------
# Ambiente da aplicação
# ----------------------------------------------------------------------
# Identifica o ambiente lógico no qual a aplicação está sendo executada.
#
# Exemplos futuros:
#
# local
# testing
# staging
# production
APP_ENV=local


# ----------------------------------------------------------------------
# Modo de depuração
# ----------------------------------------------------------------------
# Habilita recursos de diagnóstico próprios da aplicação.
#
# Essa variável não substitui as configurações de exibição e registro
# de erros definidas no php.ini.
#
# Em produção, o valor deverá ser false.
APP_DEBUG=true


# ----------------------------------------------------------------------
# UID e GID do usuário do host
# ----------------------------------------------------------------------
# O usuário www-data do contêiner PHP utilizará esses identificadores.
#
# Isso evita que arquivos criados pelo PHP dentro dos diretórios
# montados pertençam ao usuário root no Linux.
#
# Consulte os valores reais no terminal:
#
# id -u
# id -g
#
# Em instalações comuns do Linux Mint, ambos costumam ser 1000,
# mas os valores devem ser confirmados no computador.
HOST_UID=1000
HOST_GID=1000


# ----------------------------------------------------------------------
# Banco de dados MySQL
# ----------------------------------------------------------------------

# Nome do serviço MySQL dentro da rede privada do Docker.
#
# A aplicação PHP deve utilizar "mysql", e não "localhost",
# porque o banco é executado em outro contêiner.
DB_HOST=mysql

# Porta interna utilizada pelo serviço MySQL.
#
# Essa porta não precisa ser publicada no computador para que
# o contêiner PHP consiga acessar o banco.
DB_PORT=3306

# Porta pela qual ferramentas do computador acessam o MySQL Docker.
DB_FORWARD_PORT=3307

# Nome do banco criado automaticamente na primeira inicialização
# do volume do MySQL.
DB_DATABASE=programming_with_gio

# Usuário comum utilizado pela aplicação PHP.
#
# A aplicação não deve utilizar o usuário root.
DB_USERNAME=app

# Senha demonstrativa do usuário da aplicação.
#
# Substitua por uma senha local diferente no arquivo .env.
DB_PASSWORD=local_password

# Senha administrativa demonstrativa do usuário root.
#
# Substitua por outra senha local no arquivo .env.
# A aplicação PHP não deve utilizar essa credencial.
DB_ROOT_PASSWORD=local_root_password
