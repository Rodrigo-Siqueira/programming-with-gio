# ======================================================================
# PHP Docker Starter
# Exemplo de variáveis de ambiente da infraestrutura local
# ======================================================================
#
# Este arquivo documenta as variáveis necessárias para executar
# a estação de desenvolvimento.
#
# Não utilize este arquivo para armazenar senhas, tokens ou outros
# dados confidenciais.
#
# Para preparar o ambiente local, copie este arquivo:
#
# cp .env.example .env
#
# O arquivo .env será específico de cada computador e não deverá
# ser versionado pelo Git.
# ======================================================================


# ----------------------------------------------------------------------
# Nome do projeto no Docker Compose
# ----------------------------------------------------------------------
# Esse nome será usado como prefixo dos recursos criados pelo Docker,
# incluindo contêineres, redes e imagens.
#
# Use apenas letras minúsculas, números, hífens e sublinhados.
COMPOSE_PROJECT_NAME=php-docker-starter


# ----------------------------------------------------------------------
# Porta HTTP local
# ----------------------------------------------------------------------
# Porta utilizada para acessar o Nginx pelo computador.
#
# Com o valor 8080, a aplicação ficará disponível em:
#
# http://localhost:8080
#
# Caso a porta já esteja ocupada, utilize outra, como 8081.
APP_PORT=8080


# ----------------------------------------------------------------------
# Ambiente da aplicação
# ----------------------------------------------------------------------
# Identifica que a aplicação está sendo executada localmente.
#
# Essa variável poderá ser utilizada futuramente pelo código PHP
# para selecionar comportamentos e configurações de desenvolvimento.
APP_ENV=local


# ----------------------------------------------------------------------
# Modo de depuração
# ----------------------------------------------------------------------
# Habilita indicações de depuração no ambiente local.
#
# A aplicação deverá interpretar explicitamente essa variável.
# O arquivo php.ini já controla separadamente a exibição de erros.
#
# Em produção, esse valor deverá ser false.
APP_DEBUG=true